# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Notion Configuration
NOTION_API_KEY=secret_your-notion-api-key
NOTION_DATABASE_ID=your-database-id
NOTION_KNOWLEDGE_DATABASE_ID=your-knowledge-database-id  # Optional: For knowledge base storage
NOTION_PARENT_PAGE_ID=your-parent-page-id  # Required for Google Sheets → Notion autonomous agent

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Google Sheets Configuration (for autonomous Google Sheets → Notion agent)
GOOGLE_SHEETS_API_KEY=your-google-api-key  # Required for sheets-to-notion script

# Optional: External APIs for enrichment
CRUNCHBASE_API_KEY=optional-crunchbase-key
PITCHBOOK_API_KEY=optional-pitchbook-key
APOLLO_API_KEY=optional-apollo-key
CLEARBIT_API_KEY=optional-clearbit-key
ZOOMINFO_API_KEY=optional-zoominfo-key
GOOGLE_SEARCH_API_KEY=optional-google-search-key
GOOGLE_SEARCH_CX=optional-google-custom-search-cx
FIRECRAWL_API_KEY=fc-your-firecrawl-key  # Free via Lovable promo until Jan 26

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Rate Limiting
MAX_CONCURRENT_RESEARCH=3
RESEARCH_TIMEOUT_MS=300000
