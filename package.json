{
  "name": "investor-database-agent",
  "version": "1.0.0",
  "description": "AI agent that manages VC/angel investor leads in Notion via Slack",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "analyze-csv": "tsx src/scripts/analyze-csv.ts",
    "enrich-top-matches": "tsx src/scripts/enrich-top-matches.ts",
    "score-notion": "tsx src/scripts/score-notion-investors.ts",
    "sheets-to-notion": "tsx src/scripts/google-sheets-to-notion.ts"
  },
  "keywords": [
    "slack",
    "notion",
    "ai-agent",
    "vc",
    "investors"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@mendable/firecrawl-js": "^4.9.3",
    "@notionhq/client": "^2.2.15",
    "@slack/bolt": "^3.17.1",
    "axios": "^1.6.5",
    "cheerio": "^1.0.0-rc.12",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "date-fns": "^3.3.1",
    "dotenv": "^16.4.1",
    "googleapis": "^169.0.0",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
